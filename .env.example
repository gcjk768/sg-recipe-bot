# Copy to .env and fill in. Never commit .env.
#
# Only four values are required: TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID, LLM_API_KEY and TZ.
# Everything else has a sensible default.

# Telegram. Create the bot with @BotFather, add it to the channel as an administrator
# with permission to post. For a public channel use "@yourchannelname"; for a private
# channel post once after adding the bot, then read the numeric id from getUpdates.
# For a topic in a forum supergroup use CHAT/TOPIC, taken from the topic link
# t.me/c/2069000031/2765 -> <TELEGRAM_CHAT_ID>/2765 (prefix the number with -100).
TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_CHAT_ID=@yourchannelname
# Optional private chat that receives a short message when a run fails or posts nothing.
TELEGRAM_ADMIN_CHAT_ID=

# Model provider (Anthropic). ANTHROPIC_API_KEY is also accepted.
LLM_API_KEY=sk-ant-replace-me
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max, or "none" to omit the effort setting.
LLM_EFFORT=high
LLM_MAX_TOKENS=32000
# Seconds to wait for one model call before giving up.
LLM_TIMEOUT_SECONDS=600
# Server-side refusal fallbacks (beta). "default" or "off".
LLM_FALLBACKS=default
# Web search used when candidate_pages is none.
LLM_WEB_SEARCH_TOOL=web_search_20260209
LLM_WEB_SEARCH_MAX_USES=10
# Optional comma separated list of domains the model may search, for example
# recipetineats.com,thewoksoflife.com,justonecookbook.com
LLM_ALLOWED_DOMAINS=

# Run settings
TZ=Asia/Singapore
RECIPEBOT_POST_TIME=16:00
RECIPEBOT_DATA_DIR=/data
# search: the model searches the web itself. candidates: the app fetches pages listed in
# data/candidates/<category>.txt and hands their schema.org Recipe data to the model.
RECIPEBOT_SOURCE_MODE=search
RECIPEBOT_CANDIDATE_PAGES=6
RECIPEBOT_COUNT=1
RECIPEBOT_SERVINGS=2
# A Monday that starts Week A of the rotation.
RECIPEBOT_ROTATION_EPOCH=2026-09-28
# After a restart, a missed post is still made up to this many hours after RECIPEBOT_POST_TIME.
# 0 disables catch up. A day that already has a run is never posted twice.
RECIPEBOT_CATCH_UP_HOURS=6
# Also run once when the container starts (skipped when today already has a run).
RECIPEBOT_RUN_ON_START=false
# What the brief tells the model about past posts.
RECIPEBOT_HISTORY_DAYS=90
RECIPEBOT_HISTORY_MAX_LINES=150
RECIPEBOT_RECENT_MAINS=7
# Seconds to wait when fetching a recipe page for validation or candidates.
RECIPEBOT_FETCH_TIMEOUT=20
# Optional folder with system_prompt.txt and run_brief.txt that override the packaged prompts.
RECIPEBOT_PROMPTS_DIR=
RECIPEBOT_LOG_LEVEL=INFO
