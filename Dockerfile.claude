# Claude Code CLI for working on this project from the NAS.
# Build:  docker compose build claude
# Use:    docker compose run --rm claude            (interactive Claude Code in this folder)
#         docker compose run --rm claude remote-control   (drive it from the Claude app)
FROM node:20-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates git curl python3 python3-venv python3-pip sqlite3 procps \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g @anthropic-ai/claude-code \
 && npm cache clean --force

USER node
ENV HOME=/home/node
WORKDIR /workspace

ENTRYPOINT ["claude"]
